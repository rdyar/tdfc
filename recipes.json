[
{% assign first = true %}
{% for recipe in site.odds-and-ends %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {
    "title": {{ recipe.title | jsonify }},
    "content": {{ recipe.content | strip_html | jsonify }},
    "category": "odds-and-ends",
    "url": "{{ site.baseurl }}{{ recipe.url }}",
    "needsReview": {% if recipe.s %}true{% else %}false{% endif %}
  }
{% endfor %}
